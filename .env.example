# Copy to .env.local for local development. Never commit real values.

# Neon PostgreSQL connection string (server-side only). Pooled (hostname contains -pooler).
DATABASE_URL=
# Direct connection from Neon, used only for schema migrations. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Research provider: mock (default, synthetic data), google_places (real, needs key), or disabled.
RESEARCH_PROVIDER=mock
# Required only when RESEARCH_PROVIDER=google_places. Billing must be enabled on the Google Cloud project.
GOOGLE_PLACES_API_KEY=

# AI drafting: none (default, labelled templates) or anthropic.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Public origin of this deployment, for same-origin checks, for example https://employee.example.com
APP_ORIGIN=http://localhost:3000

# Session lifetime in hours (1 to 168).
SESSION_TTL_HOURS=12

# Used only by `npm run admin:create`. Remove after the first administrator is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used only by `npm run test:integration`. Must point to a dedicated test database, never production.
TEST_DATABASE_URL=
